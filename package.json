{
  "name": "workshops",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node scripts/scrub.mjs && node relay/test.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "relay": "node relay/server.mjs",
    "test:ui": "playwright test",
    "sync:brand": "node scripts/sync-brand.mjs",
    "tunnel": "node scripts/tunnel.mjs",
    "unit": "vitest run",
    "spec": "quint test relay/specs/relay.qnt --main=relayFixed && quint run relay/specs/relay.qnt --main=relayFixed --invariant=safe --max-steps=30 --max-samples=5000",
    "spec:old-order": "quint run relay/specs/relay.qnt --main=relayOldOrder --invariant=rightCodeAlwaysAdmits --max-steps=30 --max-samples=5000",
    "contract": "redocly lint relay/openapi.yaml --config relay/.redocly.yaml",
    "mutate": "node scripts/mutate-ranges.mjs && oxmutate run",
    "verify": "npm test && npm run unit && npm run spec && npm run contract && npm run mutate"
  },
  "devDependencies": {
    "@informalsystems/quint": "0.25.1",
    "@playwright/test": "1.64.1",
    "@redocly/cli": "1.34.3",
    "oxmutate": "1.5.0",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  }
}
