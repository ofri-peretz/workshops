{
  "name": "workshops",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node scripts/scrub.mjs && node relay/test.mjs",
    "lint": "eslint \"**/*.{js,mjs,cjs,ts,tsx}\"",
    "prepare": "git config core.hooksPath .githooks",
    "relay": "node relay/server.mjs",
    "test:ui": "playwright test",
    "sync:brand": "node scripts/sync-brand.mjs",
    "tunnel": "node scripts/tunnel.mjs",
    "unit": "vitest run",
    "spec": "quint test relay/specs/relay.qnt --main=relayFixed && quint run relay/specs/relay.qnt --main=relayFixed --invariant=safe --max-steps=30 --max-samples=5000",
    "spec:old-order": "quint run relay/specs/relay.qnt --main=relayOldOrder --invariant=rightCodeAlwaysAdmits --max-steps=30 --max-samples=5000",
    "contract": "redocly lint relay/openapi.yaml --config relay/.redocly.yaml",
    "mutate": "node scripts/mutate-ranges.mjs && oxmutate run",
    "verify": "npm test && npm run unit && npm run spec && npm run contract && npm run mutate"
  },
  "devDependencies": {
    "@informalsystems/quint": "0.25.1",
    "@playwright/test": "1.64.1",
    "@redocly/cli": "1.34.3",
    "eslint": "10.15.0",
    "eslint-plugin-browser-security": "3.0.2",
    "eslint-plugin-conventions": "7.0.2",
    "eslint-plugin-import-next": "3.0.2",
    "eslint-plugin-maintainability": "4.0.2",
    "eslint-plugin-modernization": "4.0.2",
    "eslint-plugin-modularity": "3.0.2",
    "eslint-plugin-node-security": "6.0.4",
    "eslint-plugin-operability": "5.0.2",
    "eslint-plugin-react-a11y": "3.0.2",
    "eslint-plugin-react-features": "2.0.2",
    "eslint-plugin-reliability": "5.0.2",
    "eslint-plugin-secure-coding": "6.1.1",
    "oxmutate": "1.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  }
}
